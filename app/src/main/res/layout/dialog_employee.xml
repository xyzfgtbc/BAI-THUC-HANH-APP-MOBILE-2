<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Điền đầy đủ thông tin. Mã và tài khoản không được trùng." android:textSize="16sp" android:paddingBottom="10dp" />
<EditText android:id="@+id/edCode" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mã nhân viên" android:inputType="text" android:singleLine="true" android:minHeight="48dp" />
<EditText android:id="@+id/edName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Họ tên" android:inputType="text" android:singleLine="true" android:minHeight="48dp" />
<EditText android:id="@+id/edEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Email" android:inputType="textEmailAddress" android:singleLine="true" android:minHeight="48dp" />
<EditText android:id="@+id/edPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Số điện thoại" android:inputType="phone" android:singleLine="true" android:minHeight="48dp" />
<EditText android:id="@+id/edRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Lương giờ (VNĐ)" android:inputType="numberDecimal" android:singleLine="true" android:minHeight="48dp" />
<EditText android:id="@+id/edAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Tên đăng nhập" android:inputType="text" android:singleLine="true" android:minHeight="48dp" />
<EditText android:id="@+id/edNewPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Mật khẩu ít nhất 6 ký tự" android:inputType="textPassword" android:singleLine="true" android:minHeight="48dp" />
</LinearLayout></ScrollView>